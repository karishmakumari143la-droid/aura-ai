import { voiceAnalyzer } from './voiceAnalyzer';

export type SpeechLanguage = 'en' | 'hi' | 'hinglish';

export type VoiceGender = 'female' | 'male' | 'neutral';

export interface VoiceProfile {
  id: string;
  name: string;
  gender: VoiceGender;
  description: string;
  languages: SpeechLanguage[];
  voiceName?: string;
  voiceLang?: string;
  rate: number;
  pitch: number;
}

export interface AvailableVoice {
  name: string;
  lang: string;
  localService: boolean;
  default: boolean;
  gender: VoiceGender;
}

export interface SpeechRecognitionHandlers {
  onResult: (transcript: string, isFinal: boolean) => void;
  onError?: (error: string) => void;
  onEnd?: () => void;
}

const STORAGE_KEY = 'aura.voice.preferences';

const DEFAULT_PROFILES: VoiceProfile[] = [
  {
    id: 'anaya',
    name: 'Anaya',
    gender: 'female',
    description: 'Indian Female · Warm & Natural',
    languages: ['hi', 'en', 'hinglish'],
    rate: 1.02,
    pitch: 1.08
  },
  {
    id: 'aarav',
    name: 'Aarav',
    gender: 'male',
    description: 'Indian Male · Warm & Professional',
    languages: ['hi', 'en', 'hinglish'],
    rate: 1.02,
    pitch: 0.92
  },
  {
    id: 'meera',
    name: 'Meera',
    gender: 'female',
    description: 'Indian Female · Professional & Clear',
    languages: ['hi', 'en', 'hinglish'],
    rate: 0.98,
    pitch: 1.02
  },
  {
    id: 'vihaan',
    name: 'Vihaan',
    gender: 'male',
    description: 'Indian Male · Confident & Clear',
    languages: ['hi', 'en', 'hinglish'],
    rate: 0.98,
    pitch: 0.94
  }
];

class SpeechService {
  private recognition: any = null;
  private isListening = false;
  private isSpeaking = false;
  private voices: SpeechSynthesisVoice[] = [];
  private selectedProfileId = 'anaya';
  private speakingRate = 1.02;
  private speakingPitch = 1.08;

  constructor() {
    this.loadPreferences();

    if (typeof window !== 'undefined') {
      const SpeechRec =
        (window as any).SpeechRecognition ||
        (window as any).webkitSpeechRecognition;

      if (SpeechRec) {
        this.recognition = new SpeechRec();
        this.recognition.continuous = false;
        this.recognition.interimResults = true;
        this.recognition.lang =
          navigator.language.toLowerCase().startsWith('hi')
            ? 'hi-IN'
            : 'en-IN';
      }

      this.refreshVoices();

      if ('speechSynthesis' in window) {
        window.speechSynthesis.addEventListener(
          'voiceschanged',
          () => this.refreshVoices()
        );
      }
    }
  }

  public getVoiceProfiles(): VoiceProfile[] {
    return DEFAULT_PROFILES.map(profile => ({
      ...profile,
      voiceName: this.findVoiceForProfile(profile)?.name,
      voiceLang: this.findVoiceForProfile(profile)?.lang
    }));
  }

  public getAvailableVoices(): AvailableVoice[] {
    return this.voices.map(voice => ({
      name: voice.name,
      lang: voice.lang,
      localService: voice.localService,
      default: voice.default,
      gender: this.inferGender(voice)
    }));
  }

  public getSelectedProfileId(): string {
    return this.selectedProfileId;
  }

  public getVoiceSettings(): { rate: number; pitch: number } {
    return {
      rate: this.speakingRate,
      pitch: this.speakingPitch
    };
  }

  public selectVoiceProfile(profileId: string): boolean {
    const profile = DEFAULT_PROFILES.find(p => p.id === profileId);

    if (!profile) {
      return false;
    }

    this.selectedProfileId = profile.id;
    this.speakingRate = profile.rate;
    this.speakingPitch = profile.pitch;
    this.savePreferences();

    return true;
  }

  public setVoiceSettings(rate: number, pitch: number): void {
    this.speakingRate = Math.max(0.6, Math.min(1.4, rate));
    this.speakingPitch = Math.max(0.5, Math.min(1.5, pitch));
    this.savePreferences();
  }

  public refreshVoices(): void {
    if (!this.isSynthesisSupported()) {
      this.voices = [];
      return;
    }

    this.voices = window.speechSynthesis.getVoices();
  }

  public isRecognitionSupported(): boolean {
    return this.recognition !== null;
  }

  public isSynthesisSupported(): boolean {
    return (
      typeof window !== 'undefined' &&
      'speechSynthesis' in window
    );
  }

  public setRecognitionLanguage(language: SpeechLanguage): void {
    if (!this.recognition) return;

    this.recognition.lang =
      language === 'hi'
        ? 'hi-IN'
        : language === 'hinglish'
          ? 'en-IN'
          : 'en-US';
  }

  public async startListening(
    handlers: SpeechRecognitionHandlers
  ): Promise<boolean> {
    if (!this.recognition) {
      handlers.onError?.(
        'Speech recognition is not supported in this browser environment. Using text input.'
      );
      return false;
    }

    if (this.isListening) {
      this.stopListening();
    }

    try {
      await voiceAnalyzer.startMicrophoneAnalysis();

      this.recognition.onresult = (event: any) => {
        let interim = '';
        let final = '';

        for (
          let i = event.resultIndex;
          i < event.results.length;
          ++i
        ) {
          if (event.results[i].isFinal) {
            final += event.results[i][0].transcript;
          } else {
            interim += event.results[i][0].transcript;
          }
        }

        handlers.onResult(
          final || interim,
          Boolean(final)
        );
      };

      this.recognition.onerror = (event: any) => {
        if (event.error === 'no-speech') {
          this.isListening = false;
          voiceAnalyzer.stopMicrophoneAnalysis();
          handlers.onEnd?.();
          return;
        }

        if (event.error === 'aborted') {
          this.isListening = false;
          voiceAnalyzer.stopMicrophoneAnalysis();
          return;
        }

        console.warn(
          'Speech recognition error:',
          event.error
        );

        voiceAnalyzer.stopMicrophoneAnalysis();
        this.isListening = false;
        handlers.onError?.(event.error);
      };

      this.recognition.onend = () => {
        voiceAnalyzer.stopMicrophoneAnalysis();
        this.isListening = false;
        handlers.onEnd?.();
      };

      this.recognition.start();
      this.isListening = true;

      return true;
    } catch (err: any) {
      console.warn(
        'Failed to start speech recognition:',
        err
      );

      voiceAnalyzer.stopMicrophoneAnalysis();
      this.isListening = false;

      handlers.onError?.(
        err?.message || 'Failed to start microphone'
      );

      return false;
    }
  }

  public stopListening(): void {
    if (this.recognition && this.isListening) {
      try {
        this.recognition.stop();
      } catch {}
    }

    voiceAnalyzer.stopMicrophoneAnalysis();
    this.isListening = false;
  }

  public speak(
    text: string,
    onStart?: () => void,
    onEnd?: () => void,
    lang?: string
  ): boolean {
    if (!this.isSynthesisSupported()) {
      onEnd?.();
      return false;
    }

    this.stopListening();
    window.speechSynthesis.cancel();

    const plainText = text
      .replace(/```[\s\S]*?```/g, 'Code block generated.')
      .replace(/`([^`]+)`/g, '$1')
      .replace(/[*#_>-]/g, ' ')
      .trim();

    if (!plainText) {
      onEnd?.();
      return false;
    }

    const profile =
      DEFAULT_PROFILES.find(
        p => p.id === this.selectedProfileId
      ) || DEFAULT_PROFILES[0];

    const utterance = new SpeechSynthesisUtterance(
      plainText.slice(0, 300)
    );

    utterance.rate = this.speakingRate;
    utterance.pitch = this.speakingPitch;

    const isHindi =
      lang === 'hi' ||
      /[\u0900-\u097F]/.test(plainText);

    const isHinglish = lang === 'hinglish';

    if (isHindi) {
      utterance.lang = 'hi-IN';
    } else if (isHinglish) {
      utterance.lang = 'en-IN';
    } else {
      utterance.lang = 'en-US';
    }

    const matchingVoice =
      this.findVoiceForProfile(profile, utterance.lang);

    if (matchingVoice) {
      utterance.voice = matchingVoice;
    }

    utterance.onstart = () => {
      this.isSpeaking = true;
      voiceAnalyzer.startSpeechModulation();
      onStart?.();
    };

    utterance.onend = () => {
      this.isSpeaking = false;
      voiceAnalyzer.stopSpeechModulation();
      onEnd?.();
    };

    utterance.onerror = () => {
      this.isSpeaking = false;
      voiceAnalyzer.stopSpeechModulation();
      onEnd?.();
    };

    window.speechSynthesis.speak(utterance);

    return true;
  }

  public previewVoice(
    profileId: string,
    language: SpeechLanguage = 'hinglish'
  ): boolean {
    const previousProfile = this.selectedProfileId;

    if (!this.selectVoiceProfile(profileId)) {
      return false;
    }

    const profile =
      DEFAULT_PROFILES.find(p => p.id === profileId);

    const previewText =
      language === 'hi'
        ? `नमस्ते, मैं ${profile?.name || 'AURA'} हूँ।`
        : language === 'en'
          ? `Hello, I am ${profile?.name || 'AURA'}.`
          : `Hi, main ${profile?.name || 'AURA'} hoon.`;

    const result = this.speak(previewText, undefined, () => {
      this.selectVoiceProfile(previousProfile);
    }, language);

    if (!result) {
      this.selectVoiceProfile(previousProfile);
    }

    return result;
  }

  public stopSpeaking(): void {
    if (this.isSynthesisSupported()) {
      window.speechSynthesis.cancel();
    }

    this.isSpeaking = false;
    voiceAnalyzer.stopSpeechModulation();
  }

  public speakWelcomeGreeting(
    userName: string,
    language: SpeechLanguage = 'hinglish'
  ): void {
    const greetings = {
      en: `Welcome back, ${userName}. AURA neural core is armed and ready.`,
      hi: `नमस्ते ${userName}, ऑरा सिस्टम सक्रिय है। आज हम क्या बना रहे हैं?`,
      hinglish: `Welcome ${userName}! AURA online hai. Aaj hum kya build karenge?`
    };

    try {
      this.speak(
        greetings[language],
        undefined,
        undefined,
        language
      );
    } catch {
      console.log(
        '[Voice] Autoplay was blocked by browser policy.'
      );
    }
  }

  private findVoiceForProfile(
    profile: VoiceProfile,
    targetLang?: string
  ): SpeechSynthesisVoice | undefined {
    const voices = this.voices;

    const india = voices.filter(v =>
      /(^|[-_])(IN|India)([-_]|$)/i.test(v.lang) ||
      /india|hindi/i.test(v.name)
    );

    const languagePool =
      targetLang === 'hi-IN'
        ? india.filter(v =>
            v.lang.toLowerCase().startsWith('hi') ||
            /hindi/i.test(v.name)
          )
        : targetLang === 'en-IN'
          ? india.filter(v =>
              v.lang.toLowerCase().startsWith('en-in') ||
              /india/i.test(v.name)
            )
          : voices.filter(v =>
              v.lang.toLowerCase().startsWith('en')
            );

    const genderPool = languagePool.filter(
      v => this.inferGender(v) === profile.gender
    );

    return (
      genderPool[0] ||
      languagePool[0] ||
      india[0] ||
      voices.find(v =>
        v.lang.toLowerCase().startsWith('en')
      ) ||
      voices[0]
    );
  }

  private inferGender(
    voice: SpeechSynthesisVoice
  ): VoiceGender {
    const name = voice.name.toLowerCase();

    if (
      /female|woman|girl|samantha|victoria|zira|karen|susan|hazel|veena|heera/.test(
        name
      )
    ) {
      return 'female';
    }

    if (
      /male|man|boy|aarav|rishi|david|daniel|alex|ravi/.test(
        name
      )
    ) {
      return 'male';
    }

    return 'neutral';
  }

  private loadPreferences(): void {
    if (typeof window === 'undefined') return;

    try {
      const raw = localStorage.getItem(STORAGE_KEY);

      if (!raw) return;

      const data = JSON.parse(raw);

      if (
        typeof data.selectedProfileId === 'string' &&
        DEFAULT_PROFILES.some(
          p => p.id === data.selectedProfileId
        )
      ) {
        this.selectedProfileId = data.selectedProfileId;
      }

      if (typeof data.rate === 'number') {
        this.speakingRate = data.rate;
      }

      if (typeof data.pitch === 'number') {
        this.speakingPitch = data.pitch;
      }
    } catch {
      // Ignore malformed local preferences.
    }
  }

  private savePreferences(): void {
    if (typeof window === 'undefined') return;

    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          selectedProfileId: this.selectedProfileId,
          rate: this.speakingRate,
          pitch: this.speakingPitch
        })
      );
    } catch {
      // Local persistence is optional.
    }
  }
}

export const speechService = new SpeechService();
